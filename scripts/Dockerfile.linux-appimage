# syntax=docker/dockerfile:1.7

FROM golang:1.23-bookworm AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH=amd64
ARG NODE_MAJOR=22
ARG WEBKIT_PKG=libwebkit2gtk-4.0-dev
ARG WAILS_TAGS=
ARG LINUXDEPLOY_VERSION=continuous

WORKDIR /app
ENV PATH="/go/bin:/opt/linuxdeploy:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    build-essential \
    pkg-config \
    file \
    xz-utils \
    desktop-file-utils \
    patchelf \
    libgtk-3-dev \
    librsvg2-dev \
    ${WEBKIT_PKG} \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN go install github.com/wailsapp/wails/v2/cmd/wails@latest

COPY go.mod go.sum ./
RUN go mod download

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

COPY . .
RUN sed -i 's|sh ../scripts/post-build.sh|sh /app/scripts/post-build.sh|g' /app/wails.json \
    && sed -i 's/\r$//' /app/scripts/post-build.sh /app/scripts/package-appimage.sh \
    && chmod +x /app/scripts/post-build.sh /app/scripts/package-appimage.sh

RUN case "${TARGETARCH}" in \
      amd64) APPIMAGE_ARCH=x86_64 ;; \
      arm64) APPIMAGE_ARCH=aarch64 ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p /opt/linuxdeploy \
    && curl -fsSL "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY_VERSION}/linuxdeploy-${APPIMAGE_ARCH}.AppImage" -o /opt/linuxdeploy/linuxdeploy \
    && curl -fsSL "https://raw.githubusercontent.com/tauri-apps/linuxdeploy-plugin-gtk/master/linuxdeploy-plugin-gtk.sh" -o /opt/linuxdeploy/linuxdeploy-plugin-gtk.sh \
    && chmod +x /opt/linuxdeploy/linuxdeploy /opt/linuxdeploy/linuxdeploy-plugin-gtk.sh

RUN if [ -n "${WAILS_TAGS}" ]; then \
        wails build -clean -platform linux/${TARGETARCH} -tags "${WAILS_TAGS}"; \
    else \
        wails build -clean -platform linux/${TARGETARCH}; \
    fi \
    && /app/scripts/package-appimage.sh "/app/build/bin/golang-wails-panel" "/app/release"

FROM scratch AS export
COPY --from=builder /app/release/ /
