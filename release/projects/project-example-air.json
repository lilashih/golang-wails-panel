[
  {
    "os": "windows",
    "title": "Golang Air 開發設定範例",
    "type": "exe",
    "key": "air",
    "start": "start /B air",
    "stop": "taskkill /IM air.exe /F /T",
    "install": ""
  },
  {
    "os": "linux",
    "title": "Golang Air 開發設定範例",
    "type": "exe",
    "key": "air",
    "start": "nohup ./air > ./app.log 2>&1 &",
    "stop": "pkill -f air",
    "install": ""
  }
] 