{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "golang-wails-panel",
  "outputfilename": "golang-wails-panel",
  "reloaddirs": "src,frontend",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "build:dir": "build",
  "postBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/post-build.ps1 \"${bin}\"",
    "linux/*": "sh ../../scripts/post-build.sh \"${bin}\""
  },
  "info": {
    "companyName": "lila",
    "productName": "golang-wails-panel",
    "productVersion": "1.0.0",
    "copyright": "Copyright (c) lila",
    "comments": "golang-wails-panel"
  },
  "author": {
    "name": "lila",
    "email": "-"
  }
}
